PORT=5000
NODE_ENV=development

# Admin & Authentication Secrets
ADMIN_PASSWORD=your_admin_password_here
JWT_SECRET=your_jwt_secret_key_here

# URLs & Domains
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
SITE_URL=https://kisanmitra.in

# Custom Domain SMTP Server (mail.shamiit.com)
SMTP_HOST=mail.shamiit.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=km@shamiit.com
SMTP_PASS=your_smtp_password_here
SMTP_FROM_NAME="KisanMitra Support"
CONTACT_RECEIVER_EMAIL=km@shamiit.com

# Brevo API (Optional Email Broadcast Service)
BREVO_API_KEY=
BREVO_SENDER_NAME="KisanMitra Support"
BREVO_SENDER_EMAIL=support@kisanmitra.com

# External Meteorological & Geocoding Endpoints
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEO_API_URL=https://geocoding-api.open-meteo.com/v1/search
BIGDATACLOUD_GEO_API_URL=https://api.bigdatacloud.net/data/reverse-geocode-client

# Agmarknet Government Mandi Data (data.gov.in)
AGMARKNET_API_KEY=your_data_gov_in_api_key_here
AGMARKNET_BASE_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070
