generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Blog {
  id        String   @id @default(uuid())
  title     String
  content   String
  category  String
  author    String
  readTime  String
  imageUrl  String
  createdAt DateTime @default(now())
}
